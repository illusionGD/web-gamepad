{
  "name": "web-gamepad",
  "version": "2.0.0",
  "description": "Framework-independent gamepad input, device handover and scene controls",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "node ../../scripts/cleanCore.mjs && rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run build && pnpm run typecheck && node tests/core.test.mjs"
  },
  "files": [
    "dist",
    "package.json",
    "README.en.md",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/cjs/index.cjs"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/illusionGD/web-gamepad"
  },
  "keywords": [],
  "author": "illusionGD",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.45.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "types": "./src/index.ts"
}
